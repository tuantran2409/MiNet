@model ExploreVM
@{
    ViewData["Title"] = "Explore";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}
<main id="site__main" class="2xl:ml-[--w-side] xl:ml-[--w-side-sm] p-2.5 h-[calc(100vh-var(--m-top))] mt-[--m-top]">
    <div class="lg:flex gap-3 max-w-[1065px] mx-auto" id="js-oversized">
        <div class="max-w-[680px] mx-auto w-full">

            @* Filters *@
            <div class="bg-white rounded-xl shadow-sm p-3 text-black border1">
                <div class="flex items-start justify-between gap-2">
                    <div>
                        <div class="font-bold text-base text-black">Explore repositories</div>
                        <p class="text-xs text-slate-500">Repositories created in the selected date range, ranked by total stars.</p>
                    </div>
                    <ion-icon name="compass-outline" class="text-lg text-slate-500"></ion-icon>
                </div>

                <form method="get" asp-controller="Explore" asp-action="Index" class="flex flex-wrap items-end gap-2 mt-3">
                    <label class="flex flex-col gap-1 text-xs font-medium text-slate-700">
                        From date
                        <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" max="@today"
                               class="border1 rounded-lg px-2 py-1.5 text-sm bg-slate-100 text-black" />
                    </label>
                    <label class="flex flex-col gap-1 text-xs font-medium text-slate-700">
                        To date
                        <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" max="@today"
                               class="border1 rounded-lg px-2 py-1.5 text-sm bg-slate-100 text-black" />
                    </label>
                    <label class="flex flex-col gap-1 text-xs font-medium text-slate-700">
                        Language
                        <select name="language" class="border1 rounded-lg px-2 py-1.5 text-sm bg-slate-100 text-black"
                                style="color:#000 !important;background-color:#f1f5f9 !important">
                            <option value="">All languages</option>
                            @foreach (var lang in ExploreVM.Languages)
                            {
                                if (Model.Language == lang)
                                {
                                    <option value="@lang" selected>@lang</option>
                                }
                                else
                                {
                                    <option value="@lang">@lang</option>
                                }
                            }
                        </select>
                    </label>
                    <button type="submit" class="bg-primary text-white text-sm font-medium px-4 py-2 rounded-lg">Search</button>
                </form>

                <div class="flex flex-wrap items-center gap-2 mt-3 text-xs">
                    @foreach (var days in new[] { 7, 30, 90 })
                    {
                        var presetFrom = Model.To.AddDays(-(days - 1)).ToString("yyyy-MM-dd");
                        var presetTo = Model.To.ToString("yyyy-MM-dd");
                        var isActive = Model.RangeInDays == days;
                        <a href="@Url.Action("Index", "Explore", new { from = presetFrom, to = presetTo, language = Model.Language })"
                           class="px-2.5 py-1 rounded-full border1 @(isActive ? "bg-primary text-white" : "bg-slate-100 text-slate-700")">
                            @days days
                        </a>
                    }
                    <span class="text-slate-500">Showing @Model.RangeInDays days (@Model.From.ToString("dd/MM/yyyy") – @Model.To.ToString("dd/MM/yyyy"))</span>
                </div>
            </div>

            @if (TempData["ExploreError"] is string exploreError)
            {
                <div class="mt-3 rounded-xl border1 bg-red-50 text-red-600 p-3 text-sm font-semibold">@exploreError</div>
            }
            @if (TempData["ExploreOk"] is string exploreOk)
            {
                <div class="mt-3 rounded-xl border1 bg-slate-100 text-slate-700 p-3 text-sm font-semibold">@exploreOk</div>
            }

            <div class="mt-3 flex items-center justify-between gap-2 text-xs text-slate-500">
                <span>Save repos to build your reading list, or share one to your feed.</span>
                <a asp-controller="Explore" asp-action="Bookmarks" class="px-2.5 py-1 rounded-full border1 bg-slate-100 text-slate-700">Saved repositories</a>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Error))
            {
                <div class="mt-3 rounded-xl border1 bg-red-50 text-red-600 p-3 text-sm">
                    <div class="font-semibold">@Model.Error</div>
                    @if (Model.RateLimited)
                    {
                        <div class="text-xs mt-1">
                            The Search API allows only 10 requests per minute without a token.
                            @if (Model.RateLimitResetAt.HasValue)
                            {
                                <span>Quota resets at @Model.RateLimitResetAt.Value.ToString("HH:mm:ss").</span>
                            }
                        </div>
                    }
                </div>
            }

            <div class="mt-3 mb-2 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500">
                <span>
                    @if (Model.Items.Count > 0)
                    {
                        <span>Top @Model.Items.Count of <b>@Model.TotalCount.ToString("N0")</b> matching repositories</span>
                    }
                    else
                    {
                        <span>No results</span>
                    }
                </span>
                <span class="flex items-center gap-2">
                    @if (Model.FromCache)
                    {
                        <span class="px-2 py-1 rounded-full bg-slate-100 text-slate-700">from cache</span>
                    }
                    @if (Model.RemainingRequests.HasValue)
                    {
                        <span class="px-2 py-1 rounded-full bg-slate-100 text-slate-700">quota left @Model.RemainingRequests</span>
                    }
                </span>
            </div>

            <div class="space-y-3">
                @if (Model.Items.Count == 0 && string.IsNullOrWhiteSpace(Model.Error))
                {
                    <div class="bg-white rounded-xl shadow-sm p-4 text-sm font-medium text-black border1">
                        No repositories were created in this range. Try a wider date range or clear the language filter.
                    </div>
                }
                else
                {
                    var rank = 0;
                    @foreach (var repo in Model.Items)
                    {
                        rank++;
                        <article class="bg-white rounded-xl shadow-sm p-3 text-black border1">
                            <div class="flex items-start gap-3">
                                <span class="text-xs font-bold text-slate-500 w-6 flex-shrink-0" style="margin-top:6px">#@rank</span>
                                <img src="@repo.OwnerAvatarUrl" alt="@repo.OwnerLogin" loading="lazy"
                                     class="w-10 h-10 rounded-lg flex-shrink-0 bg-slate-100" style="object-fit:cover" />
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-start justify-between gap-2">
                                        <a href="@repo.HtmlUrl" target="_blank" rel="noopener noreferrer"
                                           class="font-semibold text-sm text-black" style="word-break:break-all">@repo.FullName</a>
                                        <a href="@repo.HtmlUrl" target="_blank" rel="noopener noreferrer"
                                           class="text-xs px-2 py-1 rounded-lg bg-slate-900 text-white flex-shrink-0">GitHub</a>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(repo.Description))
                                    {
                                        <p class="text-xs text-slate-500 mt-1"
                                           style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
                                            @repo.Description
                                        </p>
                                    }

                                    <div class="flex flex-wrap items-center gap-3 mt-2 text-xs text-slate-500">
                                        <span class="flex items-center gap-1 font-semibold text-slate-800">
                                            <ion-icon name="star-outline" style="font-size:13px"></ion-icon>@repo.Stars.ToString("N0")
                                        </span>
                                        <span class="flex items-center gap-1">
                                            <ion-icon name="git-branch-outline" style="font-size:13px"></ion-icon>@repo.Forks.ToString("N0")
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(repo.Language))
                                        {
                                            <span class="flex items-center gap-1">
                                                <span class="inline-block" style="width:8px;height:8px;border-radius:9999px;background:#94a3b8"></span>@repo.Language
                                            </span>
                                        }
                                        <span>open issues @repo.OpenIssues.ToString("N0")</span>
                                        <span>created @repo.CreatedAt.ToString("dd/MM/yyyy")</span>
                                    </div>

                                    @if (repo.Topics.Count > 0)
                                    {
                                        <div class="flex flex-wrap gap-1 mt-2">
                                            @foreach (var topic in repo.Topics.Take(4))
                                            {
                                                <span class="text-xs px-2 py-1 rounded-full bg-slate-100 text-slate-700">@topic</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="flex flex-wrap items-center gap-2 mt-3">
                                <button type="button" onclick="openShareRepoModal(this)"
                                        class="text-xs font-medium px-2.5 py-1 rounded-full border1 bg-slate-900 text-white"
                                        data-fullname="@repo.FullName" data-url="@repo.HtmlUrl"
                                        data-avatar="@repo.OwnerAvatarUrl" data-desc="@repo.Description"
                                        data-lang="@repo.Language" data-stars="@repo.Stars" data-forks="@repo.Forks">
                                    Share to feed
                                </button>

                                <form method="post" asp-controller="Explore" asp-action="ToggleBookmark">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="RepoFullName" value="@repo.FullName" />
                                    <input type="hidden" name="RepoHtmlUrl" value="@repo.HtmlUrl" />
                                    <input type="hidden" name="OwnerAvatarUrl" value="@repo.OwnerAvatarUrl" />
                                    <input type="hidden" name="Description" value="@repo.Description" />
                                    <input type="hidden" name="Language" value="@repo.Language" />
                                    <input type="hidden" name="Stars" value="@repo.Stars" />
                                    <input type="hidden" name="ReturnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                    <button type="submit" class="text-xs font-medium px-2.5 py-1 rounded-full border1 @(Model.SavedRepos.Contains(repo.FullName) ? "bg-primary text-white" : "bg-slate-100 text-slate-700")">
                                        @(Model.SavedRepos.Contains(repo.FullName) ? "Saved" : "Save")
                                    </button>
                                </form>
                            </div>
                        </article>
                    }
                }
            </div>
        </div>

        <div class="flex-1 mt-3 lg:mt-0">
            <div class="space-y-3 pb-8">
                <div class="box p-5 px-6 border1">
                    <h3 class="font-semibold text-sm mb-2">How it works</h3>
                    <ul class="text-xs text-slate-500 space-y-2 list-disc pl-4">
                        <li>Data comes from the GitHub Search API, filtered by <b>repository creation date</b> — not by when it was starred.</li>
                        <li>Repositories created before your range will not appear, even if they are trending this month.</li>
                        <li>Results are cached for 15 minutes to protect the GitHub quota.</li>
                        <li>GitHub returns at most 1,000 results per query, so this is the top of the list, not everything.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</main>

@* Share modal: one dialog for the whole page, filled from the clicked card *@
<div id="shareRepoModal" uk-modal>
    <div class="uk-modal-dialog relative mx-auto bg-white rounded-lg shadow-xl w-[480px] text-black">
        <div class="p-5">
            <div class="text-lg font-semibold text-black">Share to feed</div>
            <p class="text-xs text-slate-500 mt-1">
                Sharing <span id="shareRepoName" class="font-semibold text-black"></span>
            </p>
        </div>

        <form asp-controller="Explore" asp-action="ShareRepo" method="post" class="px-5 pb-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="RepoFullName" id="shareRepoFullName" value="" />
            <input type="hidden" name="RepoHtmlUrl" id="shareRepoUrl" value="" />
            <input type="hidden" name="OwnerAvatarUrl" id="shareRepoAvatar" value="" />
            <input type="hidden" name="Description" id="shareRepoDesc" value="" />
            <input type="hidden" name="Language" id="shareRepoLang" value="" />
            <input type="hidden" name="Stars" id="shareRepoStars" value="0" />
            <input type="hidden" name="Forks" id="shareRepoForks" value="0" />

            <label class="text-xs font-medium text-slate-700">Your comment (optional)</label>
            <textarea name="Comment" id="shareRepoComment" rows="4"
                      class="w-full resize-none border1 rounded-lg px-3 py-2 text-sm mt-1"
                      style="color:#000 !important;background-color:#f1f5f9 !important"
                      placeholder="Why is this repo worth a look?"></textarea>

            <div class="flex justify-end gap-2 py-4 text-sm font-medium">
                <button type="button" class="px-4 py-1.5 rounded-md border1 uk-modal-close">Cancel</button>
                <button type="submit" class="px-5 py-1.5 rounded-md bg-primary text-white">Share</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openShareRepoModal(button) {
        var data = button.dataset;

        document.getElementById('shareRepoName').textContent = data.fullname || '';
        document.getElementById('shareRepoFullName').value = data.fullname || '';
        document.getElementById('shareRepoUrl').value = data.url || '';
        document.getElementById('shareRepoAvatar').value = data.avatar || '';
        document.getElementById('shareRepoDesc').value = data.desc || '';
        document.getElementById('shareRepoLang').value = data.lang || '';
        document.getElementById('shareRepoStars').value = data.stars || '0';
        document.getElementById('shareRepoForks').value = data.forks || '0';
        document.getElementById('shareRepoComment').value = '';

        UIkit.modal('#shareRepoModal').show();
    }
</script>
