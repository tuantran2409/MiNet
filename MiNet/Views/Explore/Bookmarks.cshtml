@model List<RepoBookmark>
@{
    ViewData["Title"] = "Saved repositories";
}
<main id="site__main" class="2xl:ml-[--w-side] xl:ml-[--w-side-sm] p-2.5 h-[calc(100vh-var(--m-top))] mt-[--m-top]">
    <div class="lg:flex gap-3 max-w-[1065px] mx-auto" id="js-oversized">
        <div class="max-w-[680px] mx-auto w-full">

            <div class="bg-white rounded-xl shadow-sm p-3 text-black border1">
                <div class="flex items-start justify-between gap-2">
                    <div>
                        <div class="font-bold text-base text-black">Saved repositories</div>
                        <p class="text-xs text-slate-500">@Model.Count saved repo@(Model.Count == 1 ? "" : "s") — snapshots taken when you saved them.</p>
                    </div>
                    <a asp-controller="Explore" asp-action="Index" class="text-xs font-medium px-2.5 py-1 rounded-full border1 bg-slate-100 text-slate-700">Back to Explore</a>
                </div>
            </div>

            @if (TempData["ExploreOk"] is string exploreOk)
            {
                <div class="mt-3 rounded-xl border1 bg-slate-100 text-slate-700 p-3 text-sm font-semibold">@exploreOk</div>
            }

            <div class="space-y-3 mt-3">
                @if (Model.Count == 0)
                {
                    <div class="bg-white rounded-xl shadow-sm p-4 text-sm font-medium text-black border1">
                        You have not saved any repository yet. Open the Explore page and press Save on a card.
                    </div>
                }
                else
                {
                    @foreach (var repo in Model)
                    {
                        <article class="bg-white rounded-xl shadow-sm p-3 text-black border1">
                            <div class="flex items-start gap-3">
                                @if (!string.IsNullOrWhiteSpace(repo.OwnerAvatarUrl))
                                {
                                    <img src="@repo.OwnerAvatarUrl" alt="repo owner" loading="lazy"
                                         class="w-10 h-10 rounded-lg flex-shrink-0 bg-slate-100" style="object-fit:cover" />
                                }
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-start justify-between gap-2">
                                        <a href="@repo.RepoHtmlUrl" target="_blank" rel="noopener noreferrer"
                                           class="font-semibold text-sm text-black" style="word-break:break-all">@repo.RepoFullName</a>
                                        <form method="post" asp-controller="Explore" asp-action="RemoveBookmark">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="repoFullName" value="@repo.RepoFullName" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit" class="text-xs font-medium px-2.5 py-1 rounded-full border1 bg-slate-100 text-slate-700">Remove</button>
                                        </form>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(repo.Description))
                                    {
                                        <p class="text-xs text-slate-500 mt-1"
                                           style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
                                            @repo.Description
                                        </p>
                                    }

                                    <div class="flex flex-wrap items-center gap-3 mt-2 text-xs text-slate-500">
                                        <span class="flex items-center gap-1 font-semibold text-slate-800">
                                            <ion-icon name="star-outline" style="font-size:13px"></ion-icon>@repo.Stars.ToString("N0")
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(repo.Language))
                                        {
                                            <span class="flex items-center gap-1">
                                                <span class="inline-block" style="width:8px;height:8px;border-radius:9999px;background:#94a3b8"></span>@repo.Language
                                            </span>
                                        }
                                        <span>saved @repo.DateCreated.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                </div>
                            </div>
                        </article>
                    }
                }
            </div>
        </div>
    </div>
</main>
