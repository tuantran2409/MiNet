@inject UserManager<User> UserManager;
@{
    var loggedInUser = await UserManager.GetUserAsync(User);
    var userName = loggedInUser?.UserName;
    var fullName = loggedInUser?.Name;
    var profilePictureUrl = loggedInUser?.ProfilePictureUrl;
    var currentUserId = loggedInUser?.Id;
    bool isAdmin = User.IsInRole("Admin");
}

<header class="z-[100] h-[--m-top] fixed top-0 left-0 w-full flex items-center bg-white/90 backdrop-blur-md border-b border-slate-200/80 shadow-2xs">
    <div class="2xl:w-[--w-side] lg:w-[--w-side-sm] px-4">
        <div class="flex items-center gap-2">
            <button uk-toggle="target: #site__sidebar ; cls :!-translate-x-0"
                    class="flex items-center justify-center w-9 h-9 text-xl rounded-xl hover:bg-slate-100 xl:hidden text-slate-700 transition">
                <ion-icon name="menu-outline" class="text-2xl"></ion-icon>
            </button>

            <div id="logo" class="flex items-center">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 group">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-sky-600 via-indigo-600 to-pink-500 flex items-center justify-center text-white shadow-sm shadow-indigo-500/30 group-hover:scale-105 transition-transform">
                        <ion-icon name="sparkles" class="text-xl"></ion-icon>
                    </div>
                    <span class="font-extrabold text-xl tracking-tight bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-800 bg-clip-text text-transparent">MiNet</span>
                </a>
            </div>
        </div>
    </div>

    <div class="flex-1 relative px-4">
        <div class="max-w-[700px] mx-auto flex items-center">
            <form id="search--box" method="get" asp-controller="Search" asp-action="Index"
                  class="w-full relative rounded-xl overflow-hidden bg-slate-100/80 hover:bg-slate-100 focus-within:bg-white focus-within:ring-2 focus-within:ring-primary/20 focus-within:border-primary/40 border border-slate-200/60 transition-all max-md:hidden">
                <ion-icon name="search-outline" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-lg text-slate-400"></ion-icon>
                <input type="text" name="q" placeholder="Search creators, hashtags, or topics on MiNet..."
                       class="w-full !pl-10 !pr-4 !font-medium !bg-transparent h-10 !text-sm outline-none text-slate-800 placeholder-slate-400" />
            </form>
        </div>

        <div class="flex items-center gap-3 absolute right-5 top-1/2 -translate-y-1/2 text-slate-700">
            <!-- Mobile Search Icon -->
            <a asp-controller="Search" asp-action="Index" class="md:hidden p-2 rounded-xl hover:bg-slate-100 text-slate-600 transition">
                <ion-icon name="search-outline" class="text-xl"></ion-icon>
            </a>

            <!-- Notification button -->
            <button type="button" class="p-2 rounded-xl relative hover:bg-slate-100 transition text-slate-700" id="notificationsBtn">
                <ion-icon name="notifications-outline" class="text-2xl"></ion-icon>
                <div class="absolute top-1 right-1 bg-rose-500 text-white text-[10px] font-bold h-4 min-w-[16px] px-1 rounded-full flex items-center justify-center shadow-xs" id="notificationsCount">0</div>
            </button>

            <!-- Notifications Dropdown -->
            <div class="hidden bg-white rounded-2xl shadow-xl md:w-[380px] w-screen border border-slate-200/80 overflow-hidden" uk-drop="offset:8;pos: bottom-right; mode: click; animate-out: true;">
                <div class="flex items-center justify-between p-4 border-b border-slate-100 bg-slate-50/50">
                    <h3 class="font-bold text-base text-slate-900">Notifications</h3>
                    <span class="text-xs text-slate-400">Real-time alerts</span>
                </div>

                <div class="text-sm max-h-[380px] overflow-y-auto divide-y divide-slate-100">
                    <div class="p-4 text-center text-sm text-slate-400" id="notification-dropdown">
                        Loading notifications...
                    </div>
                </div>
            </div>

            <!-- Profile Avatar & Dropdown -->
            <div class="rounded-full ring-2 ring-transparent hover:ring-primary/30 transition cursor-pointer shrink-0">
                <img src="@(!string.IsNullOrEmpty(profilePictureUrl) ? Url.Content(profilePictureUrl) : Url.Content("~/images/avatar/user.png"))"
                     class="w-9 h-9 rounded-full object-cover shadow-xs" />
            </div>

            <div class="hidden bg-white rounded-2xl shadow-xl w-64 border border-slate-200/80 p-2" uk-drop="offset:8;pos: bottom-right;animate-out: true;">
                <div class="p-3 bg-slate-50 rounded-xl mb-1 flex items-center gap-3">
                    <img src="@(!string.IsNullOrEmpty(profilePictureUrl) ? Url.Content(profilePictureUrl) : Url.Content("~/images/avatar/user.png"))"
                         class="w-10 h-10 rounded-full object-cover shadow-xs ring-1 ring-slate-200" />
                    <div class="min-w-0 flex-1">
                        <h4 class="text-sm font-bold text-slate-800 line-clamp-1">@fullName</h4>
                        <div class="text-xs text-primary font-medium line-clamp-1">@@@userName</div>
                    </div>
                </div>

                <nav class="space-y-0.5 text-sm font-medium text-slate-700">
                    @if (currentUserId.HasValue)
                    {
                        <a asp-controller="Users" asp-action="Details" asp-route-userId="@currentUserId.Value"
                           class="flex items-center gap-2.5 px-3 py-2 rounded-xl hover:bg-slate-100 hover:text-slate-900 transition">
                            <ion-icon name="person-outline" class="text-lg text-slate-500"></ion-icon>
                            <span>My Profile</span>
                        </a>
                    }

                    <a asp-controller="Settings" asp-action="Index"
                       class="flex items-center gap-2.5 px-3 py-2 rounded-xl hover:bg-slate-100 hover:text-slate-900 transition">
                        <ion-icon name="settings-outline" class="text-lg text-slate-500"></ion-icon>
                        <span>Account Settings</span>
                    </a>

                    @if (isAdmin)
                    {
                        <a asp-controller="Admin" asp-action="Index"
                           class="flex items-center gap-2.5 px-3 py-2 rounded-xl bg-purple-50 hover:bg-purple-100 text-purple-700 font-semibold transition">
                            <ion-icon name="shield-checkmark-outline" class="text-lg text-purple-600"></ion-icon>
                            <span>Admin Center</span>
                        </a>
                    }

                    <div class="border-t border-slate-100 my-1"></div>

                    <a asp-controller="Authentication" asp-action="Logout"
                       class="flex items-center gap-2.5 px-3 py-2 rounded-xl hover:bg-rose-50 text-rose-600 transition">
                        <ion-icon name="log-out-outline" class="text-lg"></ion-icon>
                        <span>Log Out</span>
                    </a>
                </nav>
            </div>
        </div>
    </div>
</header>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        fetch("/Notifications/GetCount", {
            method: 'GET',
            headers: { 'Content-Type':'application/json' }
        })
        .then(response => response.json())
        .then(data => {
            const countEl = document.getElementById("notificationsCount");
            if (countEl) countEl.innerHTML = data;
        })
        .catch(error => console.error("Error fetching notification count: ", error));

        const notifBtn = document.getElementById('notificationsBtn');
        if (notifBtn) {
            notifBtn.addEventListener('click', () => {
                fetch('/Notifications/GetNotifications')
                    .then(resp => resp.text())
                    .then(html => {
                        const dropdownEl = document.getElementById('notification-dropdown');
                        if (dropdownEl) dropdownEl.innerHTML = html;
                    });
            });
        }

        const notificationConnection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .withAutomaticReconnect()
            .build();

        notificationConnection.on("ReceiveNotification", (message) => {
            const countEl = document.getElementById("notificationsCount");
            if (countEl) countEl.innerHTML = message;
        });

        notificationConnection.start()
            .catch((err) => console.warn("Notification hub error: ", err));
    });

    function setNotificationAsRead(notificationId) {
        fetch(`/Notifications/SetNotificationAsRead?notificationId=${notificationId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        })
        .then(resp => resp.text())
        .then(html => {
            const dropdownEl = document.getElementById('notification-dropdown');
            if (dropdownEl) dropdownEl.innerHTML = html;
        });
    }
</script>
