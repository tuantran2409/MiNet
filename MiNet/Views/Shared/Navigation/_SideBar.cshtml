<div id="site__sidebar" class="fixed top-0 left-0 z-[99] pt-[--m-top] overflow-hidden transition-transform xl:duration-300 max-xl:w-full max-xl:-translate-x-full">
    <div class="p-3 max-xl:bg-white shadow-sm 2xl:w-72 sm:w-64 w-[80%] h-[calc(100vh-64px)] relative z-30 max-lg:border-r border-slate-200/80 bg-white/70 backdrop-blur-md">

        <div class="pr-2" data-simplebar>
            <!-- Main Navigation -->
            <div class="px-3 pb-2 text-xs font-bold uppercase tracking-wider text-slate-400">
                Menu
            </div>
            <nav id="side">
                <ul class="space-y-1">
                    <li>
                        <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-slate-100 font-semibold text-slate-700 hover:text-primary transition group">
                            <div class="w-8 h-8 rounded-lg bg-sky-50 text-primary flex items-center justify-center group-hover:scale-105 transition-transform">
                                <ion-icon name="home" class="text-lg"></ion-icon>
                            </div>
                            <span>Personalized Feed</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Explore" asp-action="Index" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-slate-100 font-semibold text-slate-700 hover:text-primary transition group">
                            <div class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center group-hover:scale-105 transition-transform">
                                <ion-icon name="compass" class="text-lg"></ion-icon>
                            </div>
                            <span>Explore & Trends</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Search" asp-action="Index" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-slate-100 font-semibold text-slate-700 hover:text-primary transition group">
                            <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center group-hover:scale-105 transition-transform">
                                <ion-icon name="search" class="text-lg"></ion-icon>
                            </div>
                            <span>Search Content</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Chat" asp-action="Index" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-slate-100 font-semibold text-slate-700 hover:text-primary transition group">
                            <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center group-hover:scale-105 transition-transform">
                                <ion-icon name="chatbubble-ellipses" class="text-lg"></ion-icon>
                            </div>
                            <span>Live Messages</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Favorites" asp-action="Index" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-slate-100 font-semibold text-slate-700 hover:text-primary transition group">
                            <div class="w-8 h-8 rounded-lg bg-pink-50 text-pink-600 flex items-center justify-center group-hover:scale-105 transition-transform">
                                <ion-icon name="bookmark" class="text-lg"></ion-icon>
                            </div>
                            <span>Saved Posts</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Friends" asp-action="Index" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl hover:bg-slate-100 font-semibold text-slate-700 hover:text-primary transition group">
                            <div class="w-8 h-8 rounded-lg bg-violet-50 text-violet-600 flex items-center justify-center group-hover:scale-105 transition-transform">
                                <ion-icon name="people" class="text-lg"></ion-icon>
                            </div>
                            <span>Friends Network</span>
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- Preferences -->
            <div class="border-t border-slate-100 pt-4 mt-4">
                <div class="px-3 pb-2 text-xs font-bold uppercase tracking-wider text-slate-400">
                    Preferences
                </div>
                <nav id="side">
                    <ul class="space-y-1">
                        <li>
                            <a asp-controller="Settings" asp-action="Index" class="flex items-center gap-3 px-3.5 py-2 rounded-xl hover:bg-slate-100 font-medium text-slate-600 hover:text-slate-900 transition">
                                <ion-icon name="settings-outline" class="text-lg text-slate-400"></ion-icon>
                                <span>Settings</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>

    </div>
    <div id="site__sidebar__overly"
         class="absolute top-0 left-0 z-20 w-screen h-screen xl:hidden backdrop-blur-sm" uk-toggle="target: #site__sidebar ; cls :!-translate-x-0"></div>
</div>
