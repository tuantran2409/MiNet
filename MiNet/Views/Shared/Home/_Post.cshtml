@using System.Security.Claims;
@using System.Text.RegularExpressions;
@using System.Net;
@using MiNet.Data.Models;
@model Post

@{
    int loggedInUserId = int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out int result) ? result : 0;

    var userReaction = Model.Likes.FirstOrDefault(n => n.UserId == loggedInUserId);
    bool isLiked = userReaction != null;
    bool isFavorited = Model.Favorites.Any(n => n.UserId == loggedInUserId);
    bool isPrivate = Model.IsPrivate && Model.UserId == loggedInUserId;
    bool isReported = Model.Reports.Any(n => n.UserId == loggedInUserId);

    bool showAllComments = ViewData["ShowAllComment"] as bool? ?? false;
    bool showDetails = ViewData["ShowDetails"] as bool? ?? true;

    string userAvatar = !string.IsNullOrEmpty(Model.User?.ProfilePictureUrl)
        ? (Model.User.ProfilePictureUrl.StartsWith("http") ? Model.User.ProfilePictureUrl : Url.Content("~/" + Model.User.ProfilePictureUrl.TrimStart('/')))
        : Url.Content("~/images/avatar/user.png");

    string ResolveImageUrl(string? url)
    {
        if (string.IsNullOrEmpty(url)) return string.Empty;
        if (url.StartsWith("http://") || url.StartsWith("https://")) return url;
        return Url.Content("~/" + url.TrimStart('/'));
    }

    string RenderContentWithLinks(string text)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;
        string encoded = WebUtility.HtmlEncode(text);
        // Replace #hashtags
        string withTags = Regex.Replace(encoded, @"(?:^|\s)#([a-zA-Z0-9_À-ỹ]+)", m =>
            $" <a href=\"/Explore?tag={m.Groups[1].Value}\" class=\"text-primary font-semibold hover:underline\">#{m.Groups[1].Value}</a>");
        // Replace @mentions
        string withMentions = Regex.Replace(withTags, @"(?:^|\s)@([a-zA-Z0-9_._]+)", m =>
            $" <a href=\"/Search?q={m.Groups[1].Value}\" class=\"text-indigo-600 font-semibold hover:underline\">@{m.Groups[1].Value}</a>");
        return withMentions;
    }

    TimeSpan timeSpanSincePosted = DateTime.UtcNow - Model.DateCreated;
    string displayTime = timeSpanSincePosted switch
    {
        var t when t.TotalDays >= 365 => $"{(int)(t.TotalDays / 365)}y ago",
        var t when t.TotalDays >= 30 => $"{(int)(t.TotalDays / 30)}mo ago",
        var t when t.TotalDays >= 1 => $"{(int)t.TotalDays}d ago",
        var t when t.TotalHours >= 1 => $"{(int)t.TotalHours}h ago",
        var t when t.TotalMinutes >= 1 => $"{(int)t.TotalMinutes}m ago",
        _ => "Just now"
    };

    // Reaction icon and label helper
    (string icon, string label, string colorClass) = userReaction?.ReactionType switch
    {
        ReactionType.Love => ("❤️", "Love", "text-rose-600 bg-rose-50"),
        ReactionType.Haha => ("😂", "Haha", "text-amber-500 bg-amber-50"),
        ReactionType.Wow => ("😮", "Wow", "text-amber-500 bg-amber-50"),
        ReactionType.Sad => ("😢", "Sad", "text-indigo-500 bg-indigo-50"),
        ReactionType.Angry => ("😡", "Angry", "text-orange-600 bg-orange-50"),
        _ => ("👍", "Like", isLiked ? "text-blue-600 bg-blue-50" : "text-slate-600 hover:bg-slate-100")
    };

    var rootComments = Model.Comments.Where(c => c.ParentCommentId == null).ToList();
    int totalCommentsCount = Model.Comments.Count;
}

<div id="post-@Model.Id" data-post-id="@Model.Id" class="post-card bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden text-sm font-medium transition hover:shadow-md duration-200">
    <!-- Post Heading -->
    <div class="flex items-center justify-between p-4 pb-3">
        <div class="flex items-center gap-3">
            <a asp-controller="Users" asp-action="Details" asp-route-userId="@Model.UserId" class="shrink-0">
                <img src="@userAvatar" class="w-10 h-10 rounded-full object-cover ring-2 ring-slate-100 shadow-2xs" />
            </a>
            <div>
                <a asp-controller="Users" asp-action="Details" asp-route-userId="@Model.UserId" class="font-bold text-slate-900 hover:text-primary transition line-clamp-1">
                    @(Model.User?.Name ?? "MiNet Member")
                </a>
                <div class="flex items-center gap-1.5 text-xs text-slate-400">
                    <span>@@@(Model.User?.UserName ?? "user")</span>
                    <span>•</span>
                    <span title="@Model.DateCreated.ToString("dd/MM/yyyy HH:mm")">@displayTime</span>
                    @if (isPrivate)
                    {
                        <span>•</span>
                        <span class="inline-flex items-center gap-0.5 text-slate-400" title="Only you and friends can see this">
                            <ion-icon name="lock-closed" class="text-[10px]"></ion-icon> Private
                        </span>
                    }
                </div>
            </div>
        </div>

        <!-- Options Dropdown -->
        <div>
            <button type="button" class="w-8 h-8 rounded-full hover:bg-slate-100 text-slate-500 flex items-center justify-center transition">
                <ion-icon name="ellipsis-horizontal" class="text-xl"></ion-icon>
            </button>
            <div class="w-52 bg-white rounded-xl shadow-lg border border-slate-200/80 p-1.5 post-options-dropdown"
                 uk-dropdown="pos: bottom-right; animation: uk-animation-scale-up uk-transform-origin-top-right; animate-out: true; mode: click">
                @if (Model.UserId == loggedInUserId)
                {
                    <form asp-controller="Home" asp-action="TogglePostVisibility">
                        <input type="hidden" name="postId" value="@Model.Id" />
                        <button type="submit" class="w-full flex items-center gap-2.5 px-3 py-2 text-xs font-semibold rounded-lg hover:bg-slate-100 text-slate-700 transition">
                            <ion-icon name="@(isPrivate ? "lock-open-outline" : "lock-closed-outline")" class="text-base"></ion-icon>
                            <span>Set as @(isPrivate ? "Public" : "Private")</span>
                        </button>
                    </form>
                    <hr class="my-1 border-slate-100" />
                    <button type="button" onclick="openPostDeleteConfirmation('@Model.Id')"
                            class="w-full flex items-center gap-2.5 px-3 py-2 text-xs font-semibold rounded-lg hover:bg-rose-50 text-rose-600 transition">
                        <ion-icon name="trash-outline" class="text-base"></ion-icon>
                        <span>Delete Post</span>
                    </button>
                }
                @if (!isReported)
                {
                    <form asp-controller="Home" asp-action="AddPostReport">
                        <input type="hidden" name="postId" value="@Model.Id" />
                        <button type="submit" class="w-full flex items-center gap-2.5 px-3 py-2 text-xs font-semibold rounded-lg hover:bg-rose-50 text-slate-700 hover:text-rose-600 transition">
                            <ion-icon name="flag-outline" class="text-base text-rose-500"></ion-icon>
                            <span>Report Post</span>
                        </button>
                    </form>
                }
                else
                {
                    <div class="px-3 py-2 text-xs font-medium text-amber-600 flex items-center gap-1.5">
                        <ion-icon name="alert-circle-outline"></ion-icon> Report Under Review
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Post Text Content -->
    <div class="px-4 pb-3 text-slate-800 text-[14.5px] leading-relaxed">
        @Html.Raw(RenderContentWithLinks(Model.Content))
    </div>

    <!-- Post Image (if any) with Double-Tap Heart Burst -->
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <div class="relative w-full bg-slate-900 max-h-[550px] overflow-hidden flex items-center justify-center select-none cursor-pointer group/media"
             ondblclick="triggerHeartBurst(this, @Model.Id)">
            <img src="@ResolveImageUrl(Model.ImageUrl)" alt="Post media" class="w-full h-auto max-h-[550px] object-cover hover:opacity-95 transition pointer-events-none" />
            
            <!-- Heart Burst Animated Icon Overlay -->
            <div class="heart-burst-overlay absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 transition-opacity">
                <ion-icon name="heart" class="text-white text-8xl drop-shadow-2xl filter transform scale-0 duration-300"></ion-icon>
            </div>
        </div>
    }

    <!-- Interaction Action Bar -->
    <div class="px-4 py-3 flex items-center justify-between border-t border-slate-100 text-xs font-semibold text-slate-600">
        <div class="flex items-center gap-2">
            <!-- 6 Reactions Bar Container -->
            <div class="relative reaction-group group">
                <!-- Floating Quick Reactions Bar -->
                <div class="reaction-popover absolute bottom-full left-0 mb-2 hidden group-hover:flex items-center gap-1.5 bg-white px-3 py-1.5 rounded-full shadow-xl border border-slate-200/90 z-30 transition-all duration-200 animate-in fade-in slide-in-from-bottom-2">
                    <button type="button" onclick="submitReaction(@Model.Id, 1)" title="Like" class="hover:scale-130 transition duration-150 p-1 text-xl">👍</button>
                    <button type="button" onclick="submitReaction(@Model.Id, 2)" title="Love" class="hover:scale-130 transition duration-150 p-1 text-xl">❤️</button>
                    <button type="button" onclick="submitReaction(@Model.Id, 3)" title="Haha" class="hover:scale-130 transition duration-150 p-1 text-xl">😂</button>
                    <button type="button" onclick="submitReaction(@Model.Id, 4)" title="Wow" class="hover:scale-130 transition duration-150 p-1 text-xl">😮</button>
                    <button type="button" onclick="submitReaction(@Model.Id, 5)" title="Sad" class="hover:scale-130 transition duration-150 p-1 text-xl">😢</button>
                    <button type="button" onclick="submitReaction(@Model.Id, 6)" title="Angry" class="hover:scale-130 transition duration-150 p-1 text-xl">😡</button>
                </div>

                <!-- Main Trigger Button -->
                <button type="button" onclick="submitReaction(@Model.Id, @(userReaction != null ? (int)userReaction.ReactionType : 1))"
                        class="p-2 px-3 rounded-xl transition flex items-center gap-1.5 @colorClass">
                    <span class="text-base leading-none">@icon</span>
                    <span>@label</span>
                    <span class="text-slate-400 font-normal">(@Model.Likes.Count)</span>
                </button>
            </div>

            <!-- Comment Count -->
            <a asp-controller="Home" asp-action="Details" asp-route-postId="@Model.Id"
               class="p-2 px-3 rounded-xl hover:bg-slate-100 text-slate-600 flex items-center gap-1.5 transition">
                <ion-icon name="chatbubble-outline" class="text-lg"></ion-icon>
                <span>Comments</span>
                <span class="text-slate-400 font-normal">(@totalCommentsCount)</span>
            </a>
        </div>

        <!-- Favorite / Bookmark Button -->
        <div>
            <form asp-controller="Home" asp-action="TogglePostFavorite">
                <input type="hidden" name="postId" value="@Model.Id" />
                <button type="submit" class="favorite-button p-2 px-3 rounded-xl transition flex items-center gap-1.5 @(isFavorited ? "bg-amber-50 text-amber-600" : "hover:bg-slate-100 text-slate-600")">
                    <ion-icon name="@(isFavorited ? "bookmark" : "bookmark-outline")" class="text-lg"></ion-icon>
                    <span>@(isFavorited ? "Saved" : "Save")</span>
                    @if (Model.Favorites.Count > 0)
                    {
                        <span class="text-slate-400 font-normal">(@Model.Favorites.Count)</span>
                    }
                </button>
            </form>
        </div>
    </div>

    <!-- Nested Comments Section -->
    @if (showDetails)
    {
        <div class="border-t border-slate-100 bg-slate-50/40">
            <!-- Comments List -->
            @if (rootComments.Any())
            {
                <div class="p-4 space-y-3">
                    @foreach (var comment in showAllComments ? rootComments.OrderByDescending(n => n.DateCreated) : rootComments.OrderByDescending(n => n.DateCreated).Take(3))
                    {
                        string commentAvatar = !string.IsNullOrEmpty(comment.User?.ProfilePictureUrl)
                            ? (comment.User.ProfilePictureUrl.StartsWith("http") ? comment.User.ProfilePictureUrl : Url.Content("~/" + comment.User.ProfilePictureUrl.TrimStart('/')))
                            : Url.Content("~/images/avatar/user.png");

                        <div class="comment-item group">
                            <!-- Root Comment -->
                            <div class="flex items-start gap-2.5">
                                <a asp-controller="Users" asp-action="Details" asp-route-userId="@comment.UserId">
                                    <img src="@commentAvatar" class="w-7 h-7 rounded-full object-cover shrink-0 mt-0.5" />
                                </a>
                                <div class="flex-1 bg-white p-2.5 rounded-xl border border-slate-100 shadow-2xs">
                                    <div class="flex items-center justify-between">
                                        <a asp-controller="Users" asp-action="Details" asp-route-userId="@comment.UserId" class="font-bold text-slate-900 text-xs hover:text-primary">
                                            @(comment.User?.Name ?? "User")
                                        </a>
                                        @if (User.IsInRole("Admin") || Model.UserId == loggedInUserId || comment.UserId == loggedInUserId)
                                        {
                                            <form asp-controller="Home" asp-action="RemovePostComment" class="remove-comment-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="commentId" value="@comment.Id" />
                                                <input type="hidden" name="postId" value="@comment.PostId" />
                                                <button type="submit" class="text-slate-400 hover:text-rose-600 transition text-sm">
                                                    <ion-icon name="trash-outline"></ion-icon>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                    <p class="text-slate-700 text-xs mt-1">@Html.Raw(RenderContentWithLinks(comment.Content))</p>

                                    <!-- Comment Action: Reply button -->
                                    <div class="mt-1.5 flex items-center gap-3 text-[11px] text-slate-400">
                                        <button type="button" onclick="setReplyTarget(@Model.Id, @comment.Id, '@(comment.User?.Name ?? "User")')"
                                                class="font-semibold text-primary hover:underline flex items-center gap-1">
                                            <ion-icon name="return-down-forward-outline"></ion-icon>
                                            <span>Reply</span>
                                        </button>
                                        <span>•</span>
                                        <span>@(DateTime.UtcNow.Subtract(comment.DateCreated).TotalMinutes < 60 ? $"{(int)DateTime.UtcNow.Subtract(comment.DateCreated).TotalMinutes}m ago" : comment.DateCreated.ToString("dd/MM"))</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Nested Replies List (Indented) -->
                            @if (comment.Replies != null && comment.Replies.Any())
                            {
                                <div class="ml-9 pl-3 border-l-2 border-indigo-100 mt-2 space-y-2">
                                    @foreach (var reply in comment.Replies.OrderBy(r => r.DateCreated))
                                    {
                                        string replyAvatar = !string.IsNullOrEmpty(reply.User?.ProfilePictureUrl)
                                            ? (reply.User.ProfilePictureUrl.StartsWith("http") ? reply.User.ProfilePictureUrl : Url.Content("~/" + reply.User.ProfilePictureUrl.TrimStart('/')))
                                            : Url.Content("~/images/avatar/user.png");

                                        <div class="flex items-start gap-2">
                                            <a asp-controller="Users" asp-action="Details" asp-route-userId="@reply.UserId">
                                                <img src="@replyAvatar" class="w-5 h-5 rounded-full object-cover shrink-0 mt-0.5" />
                                            </a>
                                            <div class="flex-1 bg-white p-2 rounded-lg border border-slate-100 shadow-2xs text-xs">
                                                <div class="flex items-center justify-between">
                                                    <a asp-controller="Users" asp-action="Details" asp-route-userId="@reply.UserId" class="font-bold text-slate-900 text-[11px] hover:text-primary">
                                                        @(reply.User?.Name ?? "User")
                                                    </a>
                                                    @if (User.IsInRole("Admin") || Model.UserId == loggedInUserId || reply.UserId == loggedInUserId)
                                                    {
                                                        <form asp-controller="Home" asp-action="RemovePostComment" class="remove-comment-form">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="commentId" value="@reply.Id" />
                                                            <input type="hidden" name="postId" value="@reply.PostId" />
                                                            <button type="submit" class="text-slate-400 hover:text-rose-600 transition text-xs">
                                                                <ion-icon name="trash-outline"></ion-icon>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                                <p class="text-slate-700 text-[11.5px] mt-0.5">@Html.Raw(RenderContentWithLinks(reply.Content))</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (rootComments.Count > 3 && !showAllComments)
                    {
                        <div class="pt-1 text-center">
                            <a asp-controller="Home" asp-action="Details" asp-route-postId="@Model.Id"
                               class="text-xs font-semibold text-primary hover:underline">
                                View all @totalCommentsCount comments
                            </a>
                        </div>
                    }
                </div>
            }

            <!-- Add Comment Form with Reply Indicator -->
            <form asp-controller="Home" asp-action="AddPostComment" id="comment-form-@Model.Id" class="add-comment-form p-3 border-t border-slate-100">
                @Html.AntiForgeryToken()
                <input type="hidden" name="postId" value="@Model.Id" />
                <input type="hidden" name="parentCommentId" id="parentCommentId-@Model.Id" value="" />

                <!-- Replying indicator pill -->
                <div id="replying-to-@Model.Id" class="hidden items-center justify-between bg-indigo-50 text-indigo-700 px-3 py-1 rounded-lg text-xs font-medium mb-2">
                    <span id="replying-text-@Model.Id">Replying to...</span>
                    <button type="button" onclick="cancelReplyTarget(@Model.Id)" class="text-indigo-400 hover:text-rose-600 font-bold ml-2">×</button>
                </div>

                <div class="flex items-center gap-2">
                    <div class="flex-1 relative">
                        <input type="text" name="content" id="comment-input-@Model.Id" placeholder="Write a comment..."
                               class="w-full bg-white border border-slate-200 rounded-xl px-3.5 py-2 text-xs focus:ring-1 focus:ring-primary focus:border-primary outline-none" required />
                    </div>
                    <button type="submit" class="px-4 py-2 bg-slate-900 hover:bg-primary text-white text-xs font-bold rounded-xl transition shadow-2xs">
                        Post
                    </button>
                </div>
            </form>
        </div>
    }
</div>

<script>
    if (typeof setReplyTarget === 'undefined') {
        window.setReplyTarget = function(postId, commentId, authorName) {
            const parentInput = document.getElementById('parentCommentId-' + postId);
            const contentInput = document.getElementById('comment-input-' + postId);
            const indicator = document.getElementById('replying-to-' + postId);
            const indicatorText = document.getElementById('replying-text-' + postId);

            if (parentInput) parentInput.value = commentId;
            if (indicatorText) indicatorText.innerText = 'Replying to ' + authorName;
            if (indicator) {
                indicator.classList.remove('hidden');
                indicator.classList.add('flex');
            }
            if (contentInput) {
                contentInput.value = '@@' + authorName + ' ';
                contentInput.focus();
            }
        };

        window.cancelReplyTarget = function(postId) {
            const parentInput = document.getElementById('parentCommentId-' + postId);
            const contentInput = document.getElementById('comment-input-' + postId);
            const indicator = document.getElementById('replying-to-' + postId);

            if (parentInput) parentInput.value = '';
            if (indicator) {
                indicator.classList.add('hidden');
                indicator.classList.remove('flex');
            }
            if (contentInput && contentInput.value.startsWith('@@')) {
                contentInput.value = '';
            }
        };

        window.submitReaction = async function(postId, reactionType) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/Home/SetPostReaction';

            const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const html = `
                <input type="hidden" name="__RequestVerificationToken" value="${csrfToken}" />
                <input type="hidden" name="postId" value="${postId}" />
                <input type="hidden" name="reactionType" value="${reactionType}" />
            `;
            form.innerHTML = html;
            document.body.appendChild(form);

            try {
                const formData = new FormData(form);
                const response = await fetch('/Home/SetPostReaction', {
                    method: 'POST',
                    body: formData
                });
                const htmlContent = await response.text();
                const postContainer = document.getElementById('post-' + postId);
                if (postContainer) {
                    const temp = document.createElement('div');
                    temp.innerHTML = htmlContent;
                    postContainer.replaceWith(temp.firstElementChild);
                }
            } catch (err) {
                console.error('Reaction error:', err);
                form.submit();
            } finally {
                form.remove();
            }
        };

        window.triggerHeartBurst = function(container, postId) {
            const overlay = container.querySelector('.heart-burst-overlay');
            const heartIcon = overlay?.querySelector('ion-icon');
            if (overlay && heartIcon) {
                overlay.classList.remove('opacity-0');
                overlay.classList.add('opacity-100');
                heartIcon.classList.remove('scale-0');
                heartIcon.classList.add('scale-125');

                setTimeout(() => {
                    heartIcon.classList.remove('scale-125');
                    heartIcon.classList.add('scale-0');
                    overlay.classList.remove('opacity-100');
                    overlay.classList.add('opacity-0');
                }, 700);
            }
            // Trigger Love reaction
            submitReaction(postId, 2);
        };
    }
</script>
