@* Shared "Edit Post" modal — included once per page from _Layout, opened from the post options dropdown *@
<div id="postEditModal" uk-modal>
    <div class="uk-modal-dialog relative mx-auto bg-white rounded-lg shadow-xl w-[480px] text-black">
        <div class="p-5">
            <div class="text-lg font-semibold text-black">Edit Post</div>
            <p class="text-xs text-slate-500 mt-1">Update the text of your post. Images and repo cards stay as they are.</p>
        </div>

        <form id="editPostForm" asp-controller="Home" asp-action="EditPost" method="post" class="px-5 pb-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="PostId" id="editPostId" value="" />
            <textarea name="Content" id="editPostContent" rows="5"
                      class="w-full resize-none border1 rounded-lg px-3 py-2 text-sm"
                      style="color:#000 !important;background-color:#f1f5f9 !important"
                      placeholder="What do you want to say?"></textarea>

            <div class="flex justify-end gap-2 py-4 text-sm font-medium">
                <button type="button" class="px-4 py-1.5 rounded-md border1 uk-modal-close">Cancel</button>
                <button type="submit" class="px-5 py-1.5 rounded-md bg-slate-900 text-white">Save</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openPostEditModal(postId) {
        if (window.UIkit) {
            var openDropdown = document.querySelector('.post-options-dropdown.uk-open');
            if (openDropdown) UIkit.dropdown(openDropdown).hide();
        }

        var contentEl = document.getElementById('post-content-' + postId);
        document.getElementById('editPostId').value = postId;
        document.getElementById('editPostContent').value = contentEl ? contentEl.innerText.trim() : '';

        UIkit.modal('#postEditModal').show();
    }

    document.addEventListener('DOMContentLoaded', function () {
        var form = document.getElementById('editPostForm');
        if (!form) return;

        form.addEventListener('submit', function (event) {
            event.preventDefault();

            var postId = document.getElementById('editPostId').value;
            var container = document.getElementById('post-' + postId);

            fetch(form.action, { method: 'POST', body: new FormData(form) })
                .then(function (response) {
                    if (!response.ok) throw new Error('HTTP ' + response.status);
                    return response.text();
                })
                .then(function (html) {
                    // Replace the whole card (not innerHTML) so the post id is not duplicated
                    if (container) container.outerHTML = html;
                    UIkit.modal('#postEditModal').hide();
                })
                .catch(function (error) { console.error('Edit post failed:', error); });
        });
    });
</script>
