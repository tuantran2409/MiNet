@model PostRepoShare

@* GitHub repo card embedded in a feed post (shared from the Explore page) *@
<div class="sm:px-4 p-2.5 pt-0">
    <a href="@Model.RepoHtmlUrl" target="_blank" rel="noopener noreferrer"
       class="block rounded-xl border1 bg-slate-100 p-3" style="text-decoration:none">
        <div class="flex items-start gap-3">
            @if (!string.IsNullOrWhiteSpace(Model.OwnerAvatarUrl))
            {
                <img src="@Model.OwnerAvatarUrl" alt="repo owner" loading="lazy"
                     class="w-10 h-10 rounded-lg flex-shrink-0 bg-slate-100" style="object-fit:cover" />
            }
            <div class="min-w-0 flex-1">
                <div class="font-semibold text-sm text-black" style="word-break:break-all">
                    @Model.RepoFullName
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="text-xs text-slate-500 mt-1"
                       style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">
                        @Model.Description
                    </p>
                }

                <div class="flex flex-wrap items-center gap-3 mt-2 text-xs text-slate-500">
                    <span class="flex items-center gap-1 font-semibold text-slate-800">
                        <ion-icon name="star-outline" style="font-size:13px"></ion-icon>@Model.Stars.ToString("N0")
                    </span>
                    <span class="flex items-center gap-1">
                        <ion-icon name="git-branch-outline" style="font-size:13px"></ion-icon>@Model.Forks.ToString("N0")
                    </span>
                    @if (!string.IsNullOrWhiteSpace(Model.Language))
                    {
                        <span class="flex items-center gap-1">
                            <span class="inline-block" style="width:8px;height:8px;border-radius:9999px;background:#94a3b8"></span>@Model.Language
                        </span>
                    }
                    <span class="flex items-center gap-1">
                        <ion-icon name="logo-github" style="font-size:13px"></ion-icon>github.com
                    </span>
                </div>
            </div>
        </div>
    </a>
</div>
