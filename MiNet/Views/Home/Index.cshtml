@model List<Post>;
@{
    ViewData["Title"] = "Personalized Feed";
}

<main id="site__main" class="2xl:ml-[--w-side] xl:ml-[--w-side-sm] p-3 md:p-5 h-[calc(100vh-var(--m-top))] mt-[--m-top]">
    <div class="lg:flex 2xl:gap-12 gap-8 max-w-[1100px] mx-auto" id="js-oversized">
        
        <!-- Left Main Column (Stories + Create Status + Feed) -->
        <div class="max-w-[620px] w-full mx-auto space-y-5">
            <!-- 24h Stories Tray -->
            @await Component.InvokeAsync("Stories")

            <!-- What's on your mind Card -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 shrink-0">
                        <ion-icon name="person" class="text-xl"></ion-icon>
                    </div>
                    <div class="flex-1 bg-slate-100/80 hover:bg-slate-100 text-slate-500 rounded-xl px-4 py-2.5 text-sm font-medium cursor-pointer transition"
                         uk-toggle="target: #create-status">
                        What's on your mind? Share a story or photo...
                    </div>
                    <button type="button" uk-toggle="target: #create-status"
                            class="p-2.5 rounded-xl bg-pink-50 hover:bg-pink-100 text-pink-600 transition flex items-center justify-center shrink-0">
                        <ion-icon name="image-outline" class="text-2xl"></ion-icon>
                    </button>
                </div>
            </div>

            <!-- Feed Status Bar -->
            <div class="flex items-center justify-between px-2 text-xs font-semibold text-slate-500">
                <span class="flex items-center gap-1.5">
                    <ion-icon name="sparkles" class="text-amber-500 text-sm"></ion-icon>
                    Personalized AI Feed (Collaborative Filtering)
                </span>
                <span class="text-slate-400">@Model.Count posts loaded</span>
            </div>

            <!-- Feed Posts Container -->
            <div id="posts-container" class="space-y-5">
                @if (Model.Count == 0)
                {
                    <div class="bg-white rounded-2xl p-12 text-center border border-slate-200/80 shadow-sm">
                        <div class="w-16 h-16 mx-auto mb-4 bg-sky-50 text-primary rounded-full flex items-center justify-center text-3xl">
                            <ion-icon name="sparkles-outline"></ion-icon>
                        </div>
                        <h3 class="text-lg font-bold text-slate-800 mb-1">Your Feed is Fresh!</h3>
                        <p class="text-slate-500 text-sm max-w-sm mx-auto">Follow other creators, explore trending hashtags, or create your first post to activate AI recommendations.</p>
                        <div class="mt-4 flex items-center justify-center gap-3">
                            <button type="button" uk-toggle="target: #create-status" class="px-5 py-2.5 bg-primary text-white text-xs font-bold rounded-xl shadow-sm hover:bg-primary-dark transition">
                                Create Post
                            </button>
                            <a asp-controller="Explore" asp-action="Index" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition">
                                Explore Content
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var post in Model)
                    {
                        <partial name="Home/_Post" model="post"
                                 view-data='new ViewDataDictionary(ViewData) { { "ShowAllComment", false } }' />
                    }
                }
            </div>
        </div>

        <!-- Right Sidebar Widgets -->
        <div class="hidden lg:block lg:w-[360px] space-y-5">
            <!-- Suggested Friends Widget -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5">
                @await Component.InvokeAsync("SuggestedFriends")
            </div>

            <!-- Trending Hashtags Widget -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5">
                @await Component.InvokeAsync("Hashtags")
            </div>
        </div>

    </div>
</main>

<partial name="Modals/_CreateStory" model="new StoryVM()" />
<partial name="Modals/_CreateStatus" model="new PostVM()" />
<partial name="Home/_PostDeleteConfirmation" />

<script>
    function openPostDeleteConfirmation(postId) {
        UIkit.dropdown('.post-options-dropdown').hide();
        const input = document.getElementById('deleteConfirmationPostId');
        if (input) input.value = postId;
        UIkit.modal('#postDeleteDialog').show();
    }

    document.addEventListener('DOMContentLoaded', function () {
        const postsContainer = document.getElementById('posts-container');
        if (!postsContainer) return;

        // AJAX handling for Like and Favorite buttons
        postsContainer.addEventListener('click', function (e) {
            const button = e.target.closest('.like-button, .favorite-button');
            if (button) {
                e.preventDefault();
                const form = button.closest('form');
                const postIdInput = form.querySelector('input[name="postId"]');
                if (!postIdInput) return;

                const postId = postIdInput.value;
                const postContainer = document.getElementById('post-' + postId);

                fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form)
                })
                .then(response => response.text())
                .then(html => {
                    if (postContainer) postContainer.outerHTML = html;
                })
                .catch(error => console.error('Error toggling reaction: ', error));
            }
        });

        // AJAX handling for Comment forms
        postsContainer.addEventListener('submit', function (e) {
            const form = e.target;
            if (form.classList.contains('add-comment-form') || form.classList.contains('remove-comment-form')) {
                e.preventDefault();
                const postIdInput = form.querySelector('input[name="postId"]');
                if (!postIdInput) return;

                const postId = postIdInput.value;
                const postContainer = document.getElementById('post-' + postId);

                fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form)
                })
                .then(response => response.text())
                .then(html => {
                    if (postContainer) postContainer.outerHTML = html;
                })
                .catch(error => console.error('Error updating comment: ', error));
            }
        });

        // ==================== Client-Side AI Dwell Time Tracker ====================
        // Detects when a post is visible in viewport for > 3 seconds and logs interaction View (+1.0 score)
        const recordedPosts = new Set();
        const postDwellTimers = new Map();

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                const postId = entry.target.getAttribute('data-post-id');
                if (!postId || recordedPosts.has(postId)) return;

                if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
                    // Start dwell timer (3 seconds)
                    const timer = setTimeout(() => {
                        recordedPosts.add(postId);
                        fetch('/Home/RecordInteraction', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: new URLSearchParams({ postId: postId, dwellSeconds: 3 })
                        }).catch(() => {});
                    }, 3000);
                    postDwellTimers.set(postId, timer);
                } else {
                    // Cancel timer if scrolled away before 3 seconds
                    if (postDwellTimers.has(postId)) {
                        clearTimeout(postDwellTimers.get(postId));
                        postDwellTimers.delete(postId);
                    }
                }
            });
        }, { threshold: [0.5] });

        document.querySelectorAll('.post-card').forEach(card => observer.observe(card));
    });
</script>
